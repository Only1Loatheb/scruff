# Blank lines: kept as written, as scalafmt does with sbt's settings, but
# after Black, at most 2 in a row between definitions in a template (a class,
# object, trait or enum body, a package, or the file) and 1 in a block or a
# method body; none at the start or end of the file.

<<< up to two blank lines in a row stay
val a = 1

val b = 2


val c = 3
>>>
val a = 1

val b = 2


val c = 3

<<< longer runs become two
val a = 1




val b = 2
>>>
val a = 1


val b = 2

<<< definitions in a template may have two
object A {
  val a = 1


  def b = 2
}
>>>
object A {
  val a = 1


  def b = 2
}

<<< in a method body, at most one in a row
object A {
  def f = {
    val a = 1


    val b = 2
    // note


    a + b
  }
}
>>>
object A {
  def f = {
    val a = 1

    val b = 2
    // note

    a + b
  }
}

<<< a nested object is a template too
object A {
  object B {
    val c = 1


    val d = 2
  }
}
>>>
object A {
  object B {
    val c = 1


    val d = 2
  }
}

<<< a nested function is inside too
object A:
  def f =
    def g = 1


    def h = 2
    g + h
>>>
object A:
  def f =
    def g = 1

    def h = 2
    g + h

<<< before a top-level comment, two stay
val a = 1


// next
val b = 2
>>>
val a = 1


// next
val b = 2

<<< blank lines inside braces stay
object A {

  val a = 1

}
>>>
object A {

  val a = 1

}

<<< blank lines at the start of the file go


val a = 1
>>>
val a = 1

<<< blank lines in strings and format-off blocks stay
val s = """a



b"""
// format: off
val t = 1



// format: on
val u = 2
>>>
val s = """a



b"""
// format: off
val t = 1



// format: on
val u = 2
